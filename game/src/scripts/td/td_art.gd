static var _sheet: Texture2D
static var _cache := {}


## Our own top-down piece, else a side-view inn prop that also reads from above, else a 0x72 tile.
static func tex(name: String) -> Texture2D:
	if _cache.has(name):
		return _cache[name]
	var t: Texture2D
	if RECTS.has(name):
		if _sheet == null:
			_sheet = load("res://assets/sprites/td_inn.png")
		var a := AtlasTexture.new()
		a.atlas = _sheet
		a.region = RECTS[name]
		t = a
	elif InnProps.RECTS.has(name):
		t = InnProps.tex(name)
	else:
		t = Art.region(name)
	_cache[name] = t
	return t
